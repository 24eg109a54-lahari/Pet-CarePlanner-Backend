# Server Port (Render sets this automatically, default is 5000 locally)
PORT=5000

# Node Environment
NODE_ENV=production

# Node Version (optional on Render)
NODE_VERSION=20

# ─── Aiven MySQL (cloud database) ────────────────────────────────────────────
# Option A: Full URI (recommended)
# MYSQL_URI=mysql://avnadmin:YOUR_PASSWORD@your-host.aivencloud.com:3306/defaultdb?ssl-mode=REQUIRED

# Option B: Individual variables
# DB_HOST=your-host.aivencloud.com
# DB_PORT=3306
# DB_USER=avnadmin
# DB_PASSWORD=YOUR_PASSWORD_HERE
# DB_NAME=defaultdb
# DB_SSL=true
